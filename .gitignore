# Dependencies and local link shims.
# node_modules/ contains a junction to ~/.dsh/profiles/node_modules/@deepseek-ai;
# it is a local-development crutch and must never be committed.
node_modules/

# Local-only handover notes: the unredacted copy that keeps real session ids,
# machine paths and QQ group ids. The sanitized HANDOVER.md is the tracked one.
HANDOVER.local.md

# Runtime state written by the plugin (buffer / wake log / outbox).
qq-bridge-neko-state.json
qq-bridge-neko-state.json.tmp

# Other runtime files the plugin writes next to statePath.
# Default location is $DSH_HOME, outside this repo.
# These rules matter when statePath points inside the repo.
qq-bridge-neko-settings.json
qq-bridge-neko-stickers.json
qq-bridge-neko-stickers/
qq-bridge-neko-images/
.env

# Local-only audit reports: they carry machine paths and internal line numbers.
docs/audit-*.md

# Logs and OS noise
*.log
Thumbs.db
.DS_Store

# Locally built release tarballs (npm pack). Keep them on disk, never commit.
*.tgz
